<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CleanFolder</AssemblyName>
    <RootNamespace>CleanFolder</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\cleanfolder.ico</ApplicationIcon>
    <Version>2.0.1</Version>
    <Product>Чистая папка</Product>
    <Description>Анализ папки и очистка от мусора, дубликатов и ненужных файлов</Description>
    <Copyright>worldruschel</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\cleanfolder.ico" LogicalName="CleanFolder.app.ico" />
  </ItemGroup>

</Project>
